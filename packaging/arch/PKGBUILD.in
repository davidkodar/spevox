# Maintainer: David Bolin <185648273+davidkodar@users.noreply.github.com>
pkgname=spevox
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native local-first voice dictation for KDE Plasma on Wayland'
arch=('x86_64')
url='https://github.com/davidkodar/spevox'
license=('GPL-3.0-only')
options=('!lto')
depends=('ffmpeg' 'gcc-libs' 'glibc' 'hicolor-icon-theme' 'kconfig' 'libpipewire' 'qt6-base' 'qt6-declarative' 'qt6-tools' 'vulkan-icd-loader')
optdepends=('libsecret: secure cloud-provider API key storage' 'ollama: fully local AI enhancement')
makedepends=('cargo' 'clang' 'cmake' 'git' 'qt6-tools' 'shaderc' 'vulkan-headers')
checkdepends=('dbus')
source=("$pkgname-$pkgver.tar.gz::https://github.com/davidkodar/spevox/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

prepare() {
  cd "$pkgname-$pkgver"
  # Pin the toolchain: a rustup installation would otherwise build with
  # whatever the user has set as their default, including nightly.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  local source_root="$srcdir/$pkgname-$pkgver"
  local cargo_home="${CARGO_HOME:-$HOME/.cargo}"
  export CFLAGS="${CFLAGS} -ffile-prefix-map=${source_root}=. -ffile-prefix-map=${cargo_home}=/usr/src/cargo"
  export CXXFLAGS="${CXXFLAGS} -ffile-prefix-map=${source_root}=. -ffile-prefix-map=${cargo_home}=/usr/src/cargo"
  export RUSTFLAGS="${RUSTFLAGS} --remap-path-prefix=${source_root}=. --remap-path-prefix=${cargo_home}=/usr/src/cargo"
  # Several native dependencies generate Bindgen macro-evaluation files with
  # the same temporary name. Serialize this clean package build to avoid their
  # upstream race; normal incremental developer builds remain parallel.
  QMAKE=/usr/bin/qmake6 cargo build --frozen --release --jobs 1 -p spevox-ui
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  QMAKE=/usr/bin/qmake6 dbus-run-session -- cargo test --frozen --workspace -- --test-threads=1
}

package() {
  cd "$pkgname-$pkgver"
  SPEVOX_SKIP_BUILD=1 DESTDIR="$pkgdir" PREFIX=/usr ./packaging/install.sh
}
