pkgname=fluidvoice-linux
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native local-first voice dictation for KDE Plasma on Wayland'
arch=('x86_64')
url='https://github.com/davidkodar/fluidvoice-linux'
license=('GPL-3.0-only')
depends=('ffmpeg' 'gcc-libs' 'glibc' 'libpipewire' 'qt6-base' 'qt6-declarative' 'vulkan-icd-loader')
optdepends=('libsecret: secure cloud-provider API key storage' 'ollama: fully local AI enhancement')
makedepends=('cargo' 'clang' 'cmake' 'git' 'glslc' 'qt6-tools' 'vulkan-headers')
source=("$pkgname-$pkgver.tar.gz::https://github.com/davidkodar/fluidvoice-linux/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
  cd "$pkgname-$pkgver"
  QMAKE=/usr/bin/qmake6 cargo build --release --locked -p fluidvoice-ui
}

check() {
  cd "$pkgname-$pkgver"
  QMAKE=/usr/bin/qmake6 cargo test --workspace --locked
}

package() {
  cd "$pkgname-$pkgver"
  DESTDIR="$pkgdir" PREFIX=/usr ./packaging/install.sh
}
