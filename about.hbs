<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>FluidVoice Linux third-party Rust licenses</title>
  <style>
    body { font-family: sans-serif; line-height: 1.4; max-width: 960px; margin: 2rem auto; padding: 0 1rem; }
    pre { white-space: pre-wrap; border: 1px solid #8885; border-radius: .5rem; padding: 1rem; }
    @media (prefers-color-scheme: dark) { body { background: #181a1b; color: #eee; } a { color: #6ec8ff; } }
  </style>
</head>
<body>
  <h1>FluidVoice Linux third-party Rust licenses</h1>
  <p>Generated from the locked Cargo dependency graph with cargo-about. Workspace crates authored for FluidVoice Linux are licensed separately under GPLv3.</p>
  <h2>License index</h2>
  <ul>
  {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
  {{/each}}
  </ul>
  {{#each licenses}}
  <section>
    <h2 id="{{id}}">{{name}}</h2>
    <p>Used by:</p>
    <ul>
    {{#each used_by}}
      <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
    {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
